# Azure AI Foundry / Azure OpenAI (server-side only; never commit real values)
# From Azure AI Foundry → your project → Deployments / Endpoints
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Optional API version (default: 2024-12-01-preview)
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Upstash Redis — for server-side IP rate limiting (optional but recommended)
# Copy these from the Upstash dashboard (Vercel → Storage → your database → .env.local tab)
KV_REST_API_URL=your-upstash-rest-url
KV_REST_API_TOKEN=your-upstash-rest-token
